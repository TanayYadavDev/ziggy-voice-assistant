# dev.meta.ai pe signup karo (free $20 credits) aur yahan bharo.
# Base URL aur model ID unke docs se confirm karke daalna.
META_API_KEY=
META_BASE_URL=
BRAIN_MODEL=

# --- Wake word ---
# push      = Enter dabao to talk (default, zero setup)
# porcupine = hands-free "ziggy" detection (100% on-device)
#   1. Free account banao: https://console.picovoice.ai/
#   2. "ziggy" wake word train karo, .ppn download karo, repo folder mein rakho
#   3. Neeche Access Key + file path bharo
WAKE_PROVIDER=push
PICOVOICE_ACCESS_KEY=
PORCUPINE_KEYWORD_PATH=ziggy.ppn
WAKE_SENSITIVITY=0.5

# ziggy settings
WAKE_WORD=ziggy
STT_PROVIDER=local
LANGUAGE=hi
TTS_RATE=175
MEMORY_FILE=memory.jsonl
MAX_HISTORY_TURNS=12
